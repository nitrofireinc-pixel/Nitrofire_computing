{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // WARNING: `npx wrangler deploy` replaces the live Worker `nitrofire-computing`
  // that serves https://nitrofirecomputing.com. Do not deploy until that
  // replacement is intended. This file does not declare routes or a custom domain.
  "name": "nitrofire-computing",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/rgbmatrixfx", "/rgbmatrixfx/*"]
  }
}
